{
  "info": {
    "_postman_id": "7b8d1f3c-7a64-4fa6-9b98-5a30a29e6d45",
    "name": "Hexagonal Spring Services",
    "description": "Postman collection for user, customer, order, and payment services. Run requests in order for the create-order flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "userServiceUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "customerServiceUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "orderServiceUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "paymentServiceUrl",
      "value": "http://localhost:8084"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "User Service",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.userId) { pm.collectionVariables.set('userId', body.userId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ali Khan\",\n  \"email\": \"ali.khan@example.com\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/users",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          }
        },
        {
          "name": "Get User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{userServiceUrl}}/users/{{userId}}",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Customer Service",
      "item": [
        {
          "name": "Create Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.customerId) { pm.collectionVariables.set('customerId', body.customerId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"fullName\": \"Ali Khan\",\n  \"phone\": \"+923001234567\"\n}"
            },
            "url": {
              "raw": "{{customerServiceUrl}}/customers",
              "host": [
                "{{customerServiceUrl}}"
              ],
              "path": [
                "customers"
              ]
            }
          }
        },
        {
          "name": "Get Customer",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{customerServiceUrl}}/customers/{{customerId}}",
              "host": [
                "{{customerServiceUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Order Service",
      "item": [
        {
          "name": "Create Order",
          "description": "Order-service checks customer-service through CustomerClientPort, creates payment through PaymentClientPort, then saves the order in MySQL.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.orderId) { pm.collectionVariables.set('orderId', body.orderId); }",
                  "if (body.paymentId) { pm.collectionVariables.set('paymentId', body.paymentId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"total\": {\n    \"amount\": 2500.00,\n    \"currency\": \"PKR\"\n  }\n}"
            },
            "url": {
              "raw": "{{orderServiceUrl}}/orders",
              "host": [
                "{{orderServiceUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderServiceUrl}}/orders/{{orderId}}",
              "host": [
                "{{orderServiceUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Payment Service",
      "item": [
        {
          "name": "Create Payment Directly",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.paymentId) { pm.collectionVariables.set('paymentId', body.paymentId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"total\": {\n    \"amount\": 2500.00,\n    \"currency\": \"PKR\"\n  }\n}"
            },
            "url": {
              "raw": "{{paymentServiceUrl}}/payments",
              "host": [
                "{{paymentServiceUrl}}"
              ],
              "path": [
                "payments"
              ]
            }
          }
        },
        {
          "name": "Get Payment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{paymentServiceUrl}}/payments/{{paymentId}}",
              "host": [
                "{{paymentServiceUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}
